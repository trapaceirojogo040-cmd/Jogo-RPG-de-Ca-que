# Variáveis de ambiente para Jogo-RPG-de-Caíque
# Copie este arquivo para .env e preencha com seus segredos reais.
# IMPORTANTE: Nunca envie o arquivo .env para o controle de versão.

# Exemplo de chave de API do jogo
CHAVE_API_JOGO=mude_para_uma_chave_de_api_longa_e_unica

# Exemplo de URL de conexão com o banco de dados
URL_BANCO_DADOS=postgres://usuario:senha@servidor:porta/nome_do_banco

# 🛡️ SENTINEL: Configurações obrigatórias de segurança
SENHA_BASE=mude_para_uma_senha_longa_aleatoria_e_unica
EMAIL_PROPRIETARIO=seu_email_aqui@exemplo.com
