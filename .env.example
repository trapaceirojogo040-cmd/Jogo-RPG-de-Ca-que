# Configurações de ambiente para o Jogo-RPG-de-Caíque
# Copie este arquivo para .env e preencha com seus segredos reais.
# IMPORTANTE: Nunca comite o arquivo .env para o controle de versão.

# Chave de API do jogo (exemplo hipotético)
CHAVE_API_JOGO=coloque_sua_chave_aqui

# URL de conexão com o banco de dados
URL_BANCO_DADOS=postgres://usuario:senha@localhost:5432/nome_do_banco

# Senha base para protocolos de segurança (CRÍTICO)
SENHA_BASE=coloque_uma_senha_longa_e_aleatoria_aqui

# Email do proprietário do jogo (OWNER)
EMAIL_PROPRIETARIO=seu_email@exemplo.com
