# Variáveis de ambiente para o Jogo-RPG-de-Caíque
# Copie este arquivo para .env e preencha com seus segredos reais.
# IMPORTANTE: Nunca envie o arquivo .env para o controle de versão.

# Exemplo para uma chave de API hipotética do jogo
CHAVE_API_JOGO=sua_chave_api_secreta_aqui

# Exemplo para uma string de conexão de banco de dados
URL_BANCO_DADOS=postgres://usuario:senha@host:porta/nome_do_banco

# Segredos necessários para inicialização segura
SENHA_BASE=sua_senha_da_base_aqui
EMAIL_PROPRIETARIO=seu_email_aqui
