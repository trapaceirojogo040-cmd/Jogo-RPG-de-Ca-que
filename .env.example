# Variáveis de ambiente para o Jogo-RPG-de-Caíque
# Copie este arquivo para .env e preencha com seus segredos reais.
# IMPORTANTE: Nunca envie o arquivo .env para o controle de versão.

# Exemplo de uma chave de API de jogo hipotética
CHAVE_API_JOGO=sua_chave_api_secreta_aqui

# Exemplo de uma string de conexão com o banco de dados
URL_BANCO_DADOS=postgres://usuario:senha@hostname:porta/nome_do_banco

# Segredos necessários para o funcionamento do sistema
SENHA_BASE=sua_senha_base_aqui
EMAIL_PROPRIETARIO=seu_email_aqui
