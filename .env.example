# Variáveis de ambiente para o Jogo-RPG-de-Caíque
# Copie este arquivo para .env e preencha com seus segredos reais.
# IMPORTANTE: Nunca envie o arquivo .env para o controle de versão.

# Chave da API do Jogo (exemplo hipotético)
CHAVE_API_JOGO=mude_para_uma_string_aleatoria_longa_e_unica

# URL de conexão com o banco de dados
URL_BANCO_DADOS=postgres://usuario:senha@endereco:porta/nome_banco

# Senha Base para o Protocolo de Comando
SENHA_BASE=mude_para_uma_senha_muito_segura_e_secreta

# E-mail do Proprietário
EMAIL_PROPRIETARIO=seu_email@exemplo.com
