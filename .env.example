# Configurações do Jogo-RPG-de-Ca-que
# Copie este arquivo para .env e preencha com seus segredos reais.
# 🛡️ SENTINEL: NUNCA envie o arquivo .env para o controle de versão.

# Segredos críticos para o funcionamento do sistema
SENHA_BASE=sua_senha_base_aqui
EMAIL_PROPRIETARIO=seu_email_aqui@exemplo.com

# Outras configurações (opcionais para a demo atual)
CHAVE_API_JOGO=sua_chave_api_aqui
URL_BANCO_DADOS=postgres://usuario:senha@localhost:5432/nome_do_banco
