# Variáveis de ambiente para o Jogo-RPG-de-Caíque
# Copie este arquivo para .env e preencha com seus segredos reais.
# IMPORTANTE: Nunca envie o arquivo .env para o controle de versão.

# Chave da API do Jogo (Exemplo)
CHAVE_API_JOGO=sua_chave_api_secreta_aqui

# URL de conexão com o banco de dados
URL_BANCO_DADOS=postgres://usuario:senha@host:porta/nome_banco

# Senha base para protocolos de comando
SENHA_BASE=sua_senha_mestra_aqui

# Email do Proprietário para autenticação e notificações
EMAIL_PROPRIETARIO=seu_email@exemplo.com
