# Environment variables for Jogo-RPG-de-Ca-que
# Copy this file to .env and fill in your actual secrets.
# IMPORTANT: Never commit the .env file to version control.

# Chave da API do Jogo
CHAVE_API_JOGO=sua_chave_api_aqui

# URL do Banco de Dados
URL_BANCO_DADOS=postgres://usuario:senha@host:porta/nome_banco

# Senha Base para Protocolo de Comando
SENHA_BASE=sua_senha_base_aqui

# Email do Proprietário do Sistema
EMAIL_PROPRIETARIO=seu_email_aqui
